# ==============================================================================
# Echoes of Azeroth — Environment Configuration (.env.example)
# Copy this file to .env and adjust your local World of Warcraft paths.
# ==============================================================================

# Optional Frontier LLM API Keys (Leave empty to use built-in German Warcraft Phonetic Director / Local Ollama)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ==============================================================================
# Frontier-AI Repair (Step 5 escalation — after 3 failed QA attempts)
# SECURITY: This .env file is git-ignored. NEVER paste keys into config.yaml
# or commit them to GitHub. Manage these via the Web Studio settings panel.
# ==============================================================================
# Provider: openai | openrouter | google | deepseek | ollama | none
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL=""          # Optional override (default depends on provider)
AI_MODEL=""             # Optional override (default depends on provider)
AI_ENABLED="true"       # Master switch for the AI repair
AI_REPAIR_AFTER_FAILURES="3"

# Optional Local Ollama Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Local World of Warcraft Paths (Required if not auto-detected)
WOW_ADDONS_DIR="/path/to/World of Warcraft/_retail_/Interface/AddOns"
WOW_SAVED_VARS="/path/to/World of Warcraft/_retail_/WTF/Account/YOUR_ACCOUNT_NAME/SavedVariables/ChattyLittleNpc.lua"

# Optional Player Character Placeholders (for stripping recorded player names from SavedVariables)
WOW_PLAYER_NAME="Held"
WOW_PLAYER_CLASS="Paladin"
WOW_PLAYER_RACE="Blutelf"
