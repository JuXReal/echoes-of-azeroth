# Virtual environment & Python cache
.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets (NEVER commit!)
.env
.env.local
.env.*.local
!.env.example

# Generated audio packs & local voice seeds (Respect English creators — generate locally!)
output/raw_tts_wav/
output/final_ogg/*.ogg
output/ChattyLittleNpc_*_voiceovers/
output/qa_reports/*.json
data/original/
data/reference_voices/**/*.wav
data/reference_voices/*.json
data/raw_de_text/*.json

# Keep folder structure via .gitkeep
!data/**/.gitkeep
!output/**/.gitkeep

# Model weights
*.pt
*.pth
*.gguf
*.onnx
